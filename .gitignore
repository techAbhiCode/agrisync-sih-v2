# =============================================
# AgriSync SIH v2 - Root .gitignore
# =============================================

# -------[ Node Modules ]-------
node_modules/
**/node_modules/

# -------[ Environment Variables (SECRET - DO NOT COMMIT) ]-------
.env
.env.local
.env.development
.env.production
**/.env
**/.env.local
**/.env.production

# -------[ Firebase / Google Cloud Credentials (SECRET - DO NOT COMMIT) ]-------
**/serviceAccountKey.json
serviceAccountKey.json

# -------[ Frontend (Vite/React) Build Output ]-------
frontend/dist/
frontend/dist-ssr/
frontend/*.local

# -------[ Backend Build Output ]-------
backend/dist/
backend/build/

# -------[ Logs ]-------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -------[ OS Files ]-------
.DS_Store
Thumbs.db
desktop.ini

# -------[ Editor / IDE ]-------
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# -------[ Docker ]-------
docker-data/
docker-volumes/

# -------[ Misc ]-------
*.zip
*.tar.gz
